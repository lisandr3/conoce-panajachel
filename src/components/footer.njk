<footer class="site-footer"><div class="wrap footer-grid"><div class="footer-identity">{% if footer.show_logo %}<a class="footer-name" href="{{ ('/' + lang + '/') | url }}">{% if identity.footer_logo %}<img src="{{ identity.footer_logo | url }}" alt="{{ identity.name }}">{% else %}{{ identity.name }}{% endif %}</a>{% endif %}{% if footer.show_description %}<p>{{ identity.description[lang] }}</p>{% endif %}</div>
{% for column in footer.columns %}{% if column.enabled %}<div><h2>{{ column.title[lang] }}</h2>{% if column.text %}<p>{{ column.text[lang] }}</p>{% endif %}<ul>{% for link in column.links %}{% if link.enabled %}<li><a href="{{ link.href[lang] | url }}">{{ link.label[lang] }}</a></li>{% endif %}{% endfor %}</ul></div>{% endif %}{% endfor %}</div>
<div class="wrap footer-bottom"><span>© {{ year }} {{ footer.copyright_holder }}</span><div>{% if footer.contact_enabled and identity.contact_email %}<a href="mailto:{{ identity.contact_email | escape }}">{{ 'Contacto' if lang == 'es' else 'Contact' }}</a>{% endif %}{% for link in footer.legal_links %}{% if link.enabled %}<a href="{{ link.href[lang] | url }}">{{ link.label[lang] }}</a>{% endif %}{% endfor %}{% for link in footer.social_links %}{% if link.enabled %}<a href="{{ link.href | escape }}">{{ link.label[lang] }}</a>{% endif %}{% endfor %}</div></div></footer>
