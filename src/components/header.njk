<header class="site-header"><div class="header-inner wrap">
<a class="brand" href="{{ ('/' + lang + '/') | url }}" aria-label="{{ identity.name }} — {{ 'Inicio' if lang == 'es' else 'Home' }}">{% if identity.logo %}<img src="{{ identity.logo | url }}" alt="{{ identity.name }}">{% else %}<span class="brand-top">CONOCE</span><span class="brand-name">Panajachel<span class="brand-dot">.</span></span>{% endif %}</a>
<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" hidden><span aria-hidden="true">☰</span> {{ 'Menú' if lang == 'es' else 'Menu' }}</button>
<nav id="main-nav" aria-label="{{ 'Navegación principal' if lang == 'es' else 'Main navigation' }}"><ul class="nav-list">{% for item in navigation.items %}{% if item.enabled %}<li>{% if item.children.length %}<details class="nav-dropdown"><summary>{{ item.label[lang] }}</summary><ul>{% for child in item.children %}{% if child.enabled %}<li><a href="{{ child.href[lang] | url }}">{{ child.label[lang] }}</a></li>{% endif %}{% endfor %}</ul></details>{% else %}<a href="{{ item.href[lang] | url }}" {% if section == item.id %}aria-current="page"{% endif %}>{{ item.label[lang] }}</a>{% endif %}</li>{% endif %}{% endfor %}</ul>
{% if navigation.language_switcher_enabled %}<div class="languages" aria-label="{{ 'Idioma' if lang == 'es' else 'Language' }}"><a href="{{ ('/es/' + route) | url }}" lang="es" {% if lang == 'es' %}aria-current="true"{% endif %}>ES</a><span aria-hidden="true">/</span><a href="{{ ('/en/' + route) | url }}" lang="en" {% if lang == 'en' %}aria-current="true"{% endif %}>EN</a></div>{% endif %}</nav></div></header>
